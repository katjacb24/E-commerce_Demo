# Couchbase configuration
COUCHBASE_CONNECTION_STRING=couchbases://your-cluster-endpoint
COUCHBASE_USERNAME=your-username
COUCHBASE_PASSWORD=your-password
COUCHBASE_BUCKET=your-bucket-name
COUCHBASE_SCOPE=your-scope-name
COUCHBASE_COLLECTION=your-collection-name
# Scope-relative name only — scope.search() resolves it inside COUCHBASE_SCOPE,
# so a fully-qualified "bucket.scope.index" value is rejected.
COUCHBASE_FTS_INDEX=products_search

# Vector Search
# Composite vector index over the `descriptive_vectors` field of the products
# collection, used by GET /api/products/vector-search.
COUCHBASE_VECTOR_INDEX=your-vector-index-name
# Similarity metric the index was created with. It must match, or the query
# planner will not use the index. One of:
# L2, L2_SQUARED, EUCLIDEAN, EUCLIDEAN_SQUARED, COSINE, DOT.
COUCHBASE_VECTOR_METRIC=your-similarity-metric


# Embedding Model
# Embedding Model for Vector Search
# Capella AI Services (Model Service) — embeds the natural-language query.
# The endpoint may be given bare, as ".../v1", or as the full ".../v1/embeddings".
CAPELLA_AI_ENDPOINT=https://your-ai-endpoint.ai.cloud.couchbase.com
# API key for the AI endpoint. If left blank, COUCHBASE_USERNAME/PASSWORD are
# sent as Basic auth instead.
CAPELLA_AI_API_KEY=your-API-key
# Must be the same model that produced `descriptive_vectors`, otherwise the query
# vector has the wrong dimensionality and the distances are meaningless.
CAPELLA_EMBEDDING_MODEL=your-embedding-model
# Only for asymmetric retrieval models (e.g. NVIDIA embedqa), which need to know
# they are embedding a question rather than a document. Leave blank otherwise.
CAPELLA_AI_TIMEOUT_SECONDS=20


# LLM Model
# If an OpenAI model is used
OPENAI_API_KEY=
OPEN_AI_MODEL=
# If a Capella-hosted LLM is used
# LLM_BASE_URL=https://your-ai-endpoint.ai.cloud.couchbase.com/v1.  # Add "/v1" after the url string from Capella model service
# LLM_API_KEY=your-API-key
# LLM_MODEL=your-LLM-model


# Agent Memory
AGENT_MEMORY_URL=http://localhost:8080
MEMORY_MESSAGE_TTL_SECONDS=7776000     # 90 days; conversational turns decay
MEMORY_FACT_TTL_SECONDS=0              # 0 = never expires; overrides the session
MEMORY_VERBATIM_WINDOW_TURNS=3         # newest turns given to the agent in full
MEMORY_SEARCH_THRESHOLD_TURNS=10       # past this, in-session recall becomes a search
MEMORY_CROSS_SESSION_FACT_K=10         # facts pulled from earlier visits
MEMORY_CROSS_SESSION_TURN_K=10         # conversations pulled from earlier visits
MEMORY_MAX_FACTS_PER_TURN=3            # cap on what the fact judge may store
MEMORY_MAX_FACT_LENGTH=200             # a stored fact longer than this is discarded
MEMORY_MAX_SESSION_BLOCKS=200          # most of a session one turn may pull back
