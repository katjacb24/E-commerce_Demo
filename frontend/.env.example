# Backend API base URL. Leaving a value blank falls back to the default below.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Where product image files are served from. Documents store a bare filename
# (e.g. "39773.jpg"), resolved against this base (frontend/public/product-images).
# Point this at a CDN to serve them remotely — remote hosts must also be added to
# images.remotePatterns in next.config.ts.
NEXT_PUBLIC_PRODUCT_IMAGE_BASE_URL=/product-images/
